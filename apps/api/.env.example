# Copia a .env y ajusta valores. Ver SETUP_DB.md (MySQL / Hostinger / Docker).

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# MySQL (URL de conexión Prisma)
# Ejemplo local XAMPP:
# DATABASE_URL="mysql://root:@localhost:3306/practicas_mvp"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nombre_bd"

# Local: generar con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"` (dos veces).
# Producción: obligatorio ≥32 caracteres cada uno, distintos entre sí; distintos de los valores por defecto del código.
# Si NODE_ENV=production y no se cumple, el servidor no arranca.
JWT_SECRET=replace-with-openssl-or-node-random-hex-64chars-minimum
JWT_REFRESH_SECRET=replace-with-openssl-or-node-random-hex-64chars-minimum
GOOGLE_OAUTH_STATE_SECRET=change-me-google-state-secret

# URL de la app (SPA) para el enlace «restablecer contraseña» en el correo
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Minutos de validez del enlace (debe coincidir con el texto en el email)
PASSWORD_RESET_TTL_MINUTES=30
APP_NAME=CRM

# Remitente (e.g. Gmail: usar contraseña de APLICACIÓN, no la normal)
# EMAIL_FROM=tu@correo.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE: false o omitir para puerto 587 (STARTTLS). true solo para 465.
# (El valor debe ser true/false como texto; el código no usa Boolean("false").)
# SMTP_SECURE=false
# SMTP_USER=tu@correo.com
# SMTP_PASS=abcdefghijklmnop

# --- Catálogo de viajes (ingestión PDF) ---
# Tamaño máximo de PDF (MB) en subida
TRAVEL_PDF_MAX_MB=150
# Carpeta bajo el cwd para PDFs y JSON de extracción
TRAVEL_PDF_BASE_DIR=uploads/travel-pdfs
# OpenAI: propuestas, intención de lead, extracción catálogo (local opcional si no usas IA).
OPENAI_API_KEY=
TRAVEL_OPENAI_MODEL=gpt-4o-mini

# --- Recomendación travel (feature flags; staging vs prod) ---
# Motor principal sigue siendo determinista; hybrid/geo/embeddings son opcionales.
# TRAVEL_HYBRID_RETRIEVAL_ENABLED=false
# TRAVEL_GEO_RETRIEVAL_ENABLED=false
# Si hybrid está ON pero OpenAI da 429 en embeddings de intención, evita la llamada:
# TRAVEL_SKIP_INTENT_EMBEDDING=true
# Tunings opcionales (ver backend/src/common/config/index.ts):
# TRAVEL_GEO_PREFILTER_MIN_MATCHES=3
# TRAVEL_GEO_CLOSURE_MAX_DEPTH=14
# TRAVEL_RETRIEVAL_LEXICAL_WEIGHT=0.25
# TRAVEL_RETRIEVAL_VECTOR_WEIGHT=0.45
# TRAVEL_RETRIEVAL_STRUCTURED_WEIGHT=0.3

# --- OpenAI: control de gasto y límites (multi-tenant) ---
# OPENAI_ENABLED=true
# Interruptor global en env (además de kill switch en BD vía POST /api/v1/admin/openai/kill-switch)
# OPENAI_GLOBAL_KILL_SWITCH=false
# OPENAI_INTENT_ENABLED=true
# OPENAI_COPY_ENABLED=true
# OPENAI_EMBEDDINGS_ENABLED=true
# OPENAI_PDF_EXTRACTION_ENABLED=true
# OPENAI_USD_TO_EUR_RATE=0.93
# OPENAI_MODEL_PRICING_JSON=
# Topes por defecto: en development ~1€/día empresa; en production suben (ver config/index.ts).

# --- Travel media (Unsplash / Pexels; sin claves no se llama a APIs externas) ---
# TRAVEL_MEDIA_ENABLED=true
# TRAVEL_MEDIA_PROVIDER=unsplash
# TRAVEL_MEDIA_MAX_IMAGES=5
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# OPENAI_MAX_DAILY_EUROS_PER_COMPANY=
# OPENAI_MAX_MONTHLY_EUROS_PER_COMPANY=
# OPENAI_GLOBAL_MAX_DAILY_EUROS=
# OPENAI_GLOBAL_MAX_MONTHLY_EUROS=
# OPENAI_USER_MAX_DAILY_EUROS=
# OPENAI_MAX_CALLS_PER_MINUTE_PER_COMPANY=24
# OPENAI_MAX_CALLS_PER_HOUR_PER_COMPANY=100
# OPENAI_MAX_TOKENS_PER_REQUEST=120000
# OPENAI_MAX_EMBEDDING_BATCH_ITEMS=20
# OPENAI_GUARD_SDK_MAX_RETRIES=0
# OPENAI_HTTP_RATE_PER_IP_PER_MIN=40

# --- Google OAuth ---
# URL de callback backend registrada en Google Console, por ejemplo:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Opcional: restringir logins a un dominio de Google Workspace (ejemplo: empresa.com)
# GOOGLE_ALLOWED_HOSTED_DOMAIN=
