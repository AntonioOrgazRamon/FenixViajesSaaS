    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst text = body.text || '';\n\nconst regex = /-?\\d+(\\.\\d+)?/g;\nconst matches = text.match(regex);\n\nif (!matches || matches.length === 0) {\n  return {\n    json: {\n      error: 'No se encontraron números en el texto proporcionado.'\n    }\n  };\n}\n\nconst numbers = matches.map(Number);\nconst maximo = Math.max(...numbers);\nconst lista_desc = [...numbers].sort((a, b) => b - a);\nconst lista_asc = [...numbers].sort((a, b) => a - b);\n\nreturn {\n  json: {\n    maximo: maximo,\n    lista_desc: lista_desc,\n    lista_asc: lista_asc\n  }\n};"
      },
