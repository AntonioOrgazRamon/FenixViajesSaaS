model Company {
  id                   String        @id @default(uuid()) @db.Char(36)
  name                 String        @db.VarChar(150)
  slug                 String        @unique @db.VarChar(100)
  status               CompanyStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  suspendedAt          DateTime?     @map("suspended_at")
  deletedAt            DateTime?     @map("deleted_at")
  createdBy            String?       @map("created_by") @db.Char(36)
  integrationToken     String?       @unique @map("integration_token") @db.VarChar(64)
  /// Políticas de recomendación por tenant (p. ej. proveedores bloqueados, ratios). JSON libre validado en servidor.
  recommendationPolicy Json?         @map("recommendation_policy")

  users          User[]
  auditLogs      AuditLog[]
  leads              Lead[]
  leadTravelProfiles LeadTravelProfile[]
  leadDetails    LeadDetail[]
  leadActivities LeadActivity[]
  leadNotes      LeadNote[]
  leadAgentRuns  LeadAgentRun[]

  travelDocuments         TravelDocument[]
  travelTrips             TravelTrip[]
  destinations            Destination[]
  geoPlaces               GeoPlace[]
  travelImportJobs        TravelImportJob[]
  proposals               Proposal[]
  proposalVersions        ProposalVersion[]
  proposalTrips           ProposalTrip[]
  proposalArtifacts       ProposalArtifact[]
  recommendationRuns      RecommendationRun[]
  recommendationFeedback  RecommendationFeedback[]
  recommendationItems     RecommendationItem[]
  tripEmbeddings          TravelTripEmbedding[]
  openAIUsageLogs         OpenAIUsageLog[]
  openAIUsageBudget       OpenAIUsageBudget?
  travelJsonImportBatches TravelJsonImportBatch[]
  travelJsonImportItems   TravelJsonImportItem[]
  travelMediaAssets       TravelMediaAsset[]
  travelMediaJobs         TravelMediaJob[]

  @@index([status])
  @@map("companies")
}

model User {
  id                    String          @id @default(uuid()) @db.Char(36)
  companyId             String?         @map("company_id") @db.Char(36)
  email                 String          @unique @db.VarChar(255)
  passwordHash          String          @map("password_hash")
  role                  Role
  status                UserStatus      @default(ACTIVE)
  firstName             String          @map("first_name")
  lastName              String          @map("last_name")
  phone                 String?
  /// Nombre visible (UI); opcional. Si null, se puede derivar de nombre + apellidos.
  displayName           String?         @map("display_name") @db.VarChar(150)
  locale                String?
  timezone              String?
  /// Preferencia de reloj: "24h" | "12h"
  timeFormat            String?         @map("time_format") @db.VarChar(8)
  /// Estilo de fecha: "dmy" | "mdy" | "ymd" | "locale"
  dateFormat            String?         @map("date_format") @db.VarChar(16)
  avatarUrl             String?         @map("avatar_url") @db.VarChar(500)
  avatarType            UserAvatarType  @default(DEFAULT) @map("avatar_type")
  avatarBackgroundColor String?         @map("avatar_background_color") @db.VarChar(7)
  avatarTextColor       String?         @map("avatar_text_color") @db.VarChar(7)
  avatarInitials        String?         @map("avatar_initials") @db.VarChar(3)
  avatarShape           UserAvatarShape @default(CIRCLE) @map("avatar_shape")
  theme                 Theme           @default(SYSTEM)
  /// Preferencias de cuenta (notificaciones, etc.) en JSON; null = defaults en servidor.
  profilePreferences    Json?           @map("profile_preferences")
  googleId              String?         @unique @map("google_id") @db.VarChar(255)
  authProvider          AuthProvider    @default(LOCAL) @map("auth_provider")
  failedLoginAttempts   Int             @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?       @map("locked_until")
  lastLoginAt           DateTime?       @map("last_login_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  company                   Company?                @relation(fields: [companyId], references: [id])
  sessions                  Session[]
  resetTokens               PasswordResetToken[]
  auditLogs                 AuditLog[]              @relation("ActorLogs")
  uploadedTravelJsonBatches TravelJsonImportBatch[] @relation("TravelJsonImportUploadedBy")
  assignedLeads             Lead[]                  @relation("LeadAssigned")
  createdLeads              Lead[]                  @relation("LeadCreated")
  leadActivities            LeadActivity[]
  leadNotes                 LeadNote[]
  proposalsCreated          Proposal[]              @relation("ProposalCreatedBy")
  proposalsAssigned         Proposal[]              @relation("ProposalAssigned")
  proposalVersionsCreated   ProposalVersion[]       @relation("ProposalVersionCreatedBy")
  recommendationRunsCreated RecommendationRun[]     @relation("RecommendationRunCreatedBy")
  openAIUsageLogs           OpenAIUsageLog[]

  @@index([companyId, role, status])
  @@index([companyId, status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  companyId        String?   @map("company_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt, expiresAt])
  @@index([companyId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  /// SHA-256 hex (o HMAC) del token en claro. Nunca guardar el token en texto plano.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String?  @map("company_id") @db.Char(36)
  actorUserId     String?  @map("actor_user_id") @db.Char(36)
  actorRole       String?  @map("actor_role")
  action          String
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  targetCompanyId String?  @map("target_company_id") @db.Char(36)
  result          String
  reason          String?
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  company   Company? @relation(fields: [companyId], references: [id])
  actorUser User?    @relation("ActorLogs", fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Lead {
  id                String        @id @default(uuid()) @db.Char(36)
  companyId         String        @map("company_id") @db.Char(36)
  source            LeadSource
  sourceDetail      String?       @map("source_detail") @db.VarChar(150)
  status            LeadStatus    @default(NEW)
  priority          LeadPriority?
  firstName         String?       @map("first_name") @db.VarChar(120)
  lastName          String?       @map("last_name") @db.VarChar(120)
  fullName          String?       @map("full_name") @db.VarChar(255)
  email             String?       @db.VarChar(255)
  phone             String?       @db.VarChar(50)
  companyName       String?       @map("company_name") @db.VarChar(180)
  country           String?       @db.VarChar(80)
  language          LeadLanguage?
  timezone          String?       @db.VarChar(100)
  message           String?       @db.Text
  rawPayload        Json?         @map("raw_payload")
  normalizedPayload Json?         @map("normalized_payload")
  leadScore         Int?          @map("lead_score")
  assignedUserId    String?       @map("assigned_user_id") @db.Char(36)
  createdByUserId   String?       @map("created_by_user_id") @db.Char(36)
  lastAgentRunAt    DateTime?     @map("last_agent_run_at")
  lastContactedAt   DateTime?     @map("last_contacted_at")
  convertedAt       DateTime?     @map("converted_at")
  lostAt            DateTime?     @map("lost_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id])
  assignedUser       User?               @relation("LeadAssigned", fields: [assignedUserId], references: [id])
  createdByUser      User?               @relation("LeadCreated", fields: [createdByUserId], references: [id])
  details            LeadDetail?
  travelProfile      LeadTravelProfile?
  activities         LeadActivity[]
  notes              LeadNote[]
  agentRuns          LeadAgentRun[]
  proposals          Proposal[]
  recommendationRuns RecommendationRun[]

  @@index([companyId, status, createdAt])
  @@index([companyId, source, createdAt])
  @@index([companyId, assignedUserId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@map("leads")
}

model LeadTravelProfile {
  id                   String               @id @default(uuid()) @db.Char(36)
  companyId            String               @map("company_id") @db.Char(36)
  leadId               String               @unique @map("lead_id") @db.Char(36)
  destinationText      String?              @map("destination_text") @db.VarChar(500)
  preferredDestinations Json?               @map("preferred_destinations")
  activitiesText       String?              @map("activities_text") @db.Text
  activityTags         Json?                @map("activity_tags")
  travelDateText       String?              @map("travel_date_text") @db.VarChar(500)
  travelDateFrom       DateTime?            @map("travel_date_from")
  travelDateTo         DateTime?            @map("travel_date_to")
  flexibleDates        Boolean?             @map("flexible_dates")
  /** Duración orientativa en días (captación estructurada). */
  durationDays         Int?                 @map("duration_days")
  budgetAmount         Decimal?             @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency       String               @default("EUR") @map("budget_currency") @db.VarChar(8)
  budgetType           TravelLeadBudgetType @default(UNKNOWN) @map("budget_type")
  tripType             TravelLeadTripType   @default(UNKNOWN) @map("trip_type")
  departureAirportText  String?             @map("departure_airport_text") @db.VarChar(200)
  departureAirportCode  String?             @map("departure_airport_code") @db.VarChar(12)
  rawFormPayload       Json?                @map("raw_form_payload")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, leadId])
  @@map("lead_travel_profiles")
}

model LeadDetail {
  id                 String   @id @default(uuid()) @db.Char(36)
  leadId             String   @unique @map("lead_id") @db.Char(36)
  companyId          String   @map("company_id") @db.Char(36)
  purchaseHistory    Json?    @map("purchase_history")
  currentContext     Json?    @map("current_context")
  requirements       Json?
  preferences        Json?
  technicalSnapshot  Json?    @map("technical_snapshot")
  commercialSnapshot Json?    @map("commercial_snapshot")
  extraData          Json?    @map("extra_data")
  travelContext      Json?    @map("travel_context")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, leadId])
  @@map("lead_details")
}

model LeadActivity {
  id           String           @id @default(uuid()) @db.Char(36)
  companyId    String           @map("company_id") @db.Char(36)
  leadId       String           @map("lead_id") @db.Char(36)
  actorUserId  String?          @map("actor_user_id") @db.Char(36)
  actorType    LeadActorType    @map("actor_type")
  activityType LeadActivityType @map("activity_type")
  title        String           @db.VarChar(160)
  description  String?          @db.Text
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorUser User?   @relation(fields: [actorUserId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@index([companyId, activityType, createdAt])
  @@map("lead_activities")
}

model LeadNote {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @map("company_id") @db.Char(36)
  leadId       String    @map("lead_id") @db.Char(36)
  authorUserId String    @map("author_user_id") @db.Char(36)
  content      String    @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorUserId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@map("lead_notes")
}

model LeadAgentRun {
  id            String               @id @default(uuid()) @db.Char(36)
  companyId     String               @map("company_id") @db.Char(36)
  leadId        String               @map("lead_id") @db.Char(36)
  agentKey      String               @map("agent_key") @db.VarChar(100)
  triggerType   LeadAgentTriggerType @map("trigger_type")
  status        LeadAgentRunStatus
  inputPayload  Json?                @map("input_payload")
  outputPayload Json?                @map("output_payload")
  errorMessage  String?              @map("error_message") @db.Text
  startedAt     DateTime?            @map("started_at")
  finishedAt    DateTime?            @map("finished_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId, createdAt])
  @@map("lead_agent_runs")
}

// ---------------------------------------------------------------------------
// Catálogo de viajes (ingestión PDF → viajes estructurados, multiempresa)
// ---------------------------------------------------------------------------

enum TravelDocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum TravelTripStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Fotos de catálogo vía Unsplash/Pexels (URLs + metadatos; sin binarios).
enum TravelMediaSourceProvider {
  UNSPLASH
  PEXELS
}

enum TravelMediaJobStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum DestinationKind {
  COUNTRY
  REGION
  CITY
  AREA
  ATTRACTION
}

/// Jerarquía geográfica por tenant (progresiva; coexiste con Destination legacy).
enum GeoPlaceKind {
  CONTINENT
  MACRO_REGION
  COUNTRY
  REGION
  CITY
  ISLAND
  AREA
  ATTRACTION
  POI
}

enum TripGeoPlaceRole {
  PRIMARY
  STOP
  TRANSIT
  OPTIONAL
}

enum TripGeoPlaceSource {
  MANUAL
  IMPORT
  AI
  BACKFILL
}

enum TripServiceKind {
  INCLUDED
  NOT_INCLUDED
  OPTIONAL
}

enum TravelImportJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum TravelJsonImportBatchStatus {
  UPLOADED
  VALIDATED
  PARTIAL_ERRORS
  APPROVED
  IMPORTED
  FAILED
}

enum TravelJsonImportItemValidationStatus {
  VALID
  WARNING
  INVALID
}

model TravelDocument {
  id                String               @id @default(uuid()) @db.Char(36)
  companyId         String               @map("company_id") @db.Char(36)
  filename          String               @db.VarChar(255)
  originalName      String               @map("original_name") @db.VarChar(500)
  mimeType          String               @map("mime_type") @db.VarChar(120)
  size              Int
  storagePath       String               @map("storage_path") @db.VarChar(1000)
  status            TravelDocumentStatus @default(UPLOADED)
  totalPages        Int?                 @map("total_pages")
  extractedTextPath String?              @map("extracted_text_path") @db.VarChar(1000)
  errorMessage      String?              @map("error_message") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips      TravelTrip[]
  importJobs TravelImportJob[]

  @@index([companyId, status, createdAt])
  @@map("travel_documents")
}

model TravelTrip {
  id                String                @id @default(uuid()) @db.Char(36)
  companyId         String                @map("company_id") @db.Char(36)
  documentId        String?               @map("document_id") @db.Char(36)
  /// Slug estable por tenant para deduplicar importaciones JSON (no confundir con URL pública).
  importSlug        String?               @map("import_slug") @db.VarChar(200)
  title             String                @db.VarChar(500)
  provider          String?               @db.VarChar(255)
  season            String?               @db.VarChar(120)
  mainDestination   String?               @map("main_destination") @db.VarChar(300)
  description       String?               @db.Text
  durationDays      Int?                  @map("duration_days")
  durationNights    Int?                  @map("duration_nights")
  indicativePrice   Decimal?              @map("indicative_price") @db.Decimal(12, 2)
  currency          String?               @db.VarChar(3)
  status            TravelTripStatus      @default(PENDING_REVIEW)
  confidenceScore   Float?                @map("confidence_score")
  sourcePageStart   Int?                  @map("source_page_start")
  sourcePageEnd     Int?                  @map("source_page_end")
  rawExtractedText  String?               @map("raw_extracted_text") @db.LongText
  luxuryLevel       LuxuryLevel           @default(UNKNOWN) @map("luxury_level")
  budgetTier        TripBudgetTier        @default(UNKNOWN) @map("budget_tier")
  pace              TripPace              @default(UNKNOWN)
  climatePreference TripClimatePreference @default(UNKNOWN) @map("climate_preference")
  exclusivity       TripExclusivity       @default(UNKNOWN)
  /// Reservado Fase 2: clave de namespace para vectores / features precomputados.
  embeddingKey      String?               @map("embedding_key") @db.VarChar(120)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document            TravelDocument?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tripDestinations    TravelTripDestination[]
  itineraryDays       TripItineraryDay[]
  services            TripCatalogService[]
  departures          TripDeparture[]
  hotels              TripHotel[]
  highlights          TripHighlight[]
  observations        TripObservation[]
