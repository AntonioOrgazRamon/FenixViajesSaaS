model Proposal {
  id              String         @id @default(uuid()) @db.Char(36)
  companyId       String         @map("company_id") @db.Char(36)
  leadId          String         @map("lead_id") @db.Char(36)
  createdByUserId String?        @map("created_by_user_id") @db.Char(36)
  assignedUserId  String?        @map("assigned_user_id") @db.Char(36)
  status          ProposalStatus @default(DRAFT)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdByUser User?             @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
