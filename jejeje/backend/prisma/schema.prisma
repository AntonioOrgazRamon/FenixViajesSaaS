  reasons           Json?
  createdAt         DateTime @default(now()) @map("created_at")

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalVersion ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  travelTrip      TravelTrip      @relation(fields: [travelTripId], references: [id], onDelete: Restrict)

  @@unique([proposalVersionId, travelTripId])
  @@index([companyId, proposalVersionId])
  @@index([travelTripId])
  @@map("proposal_trips")
}

model ProposalArtifact {
  id                String               @id @default(uuid()) @db.Char(36)
  companyId         String               @map("company_id") @db.Char(36)
  proposalVersionId String               @map("proposal_version_id") @db.Char(36)
  kind              ProposalArtifactKind
  storagePath       String               @map("storage_path") @db.VarChar(1000)
  publicUrl         String?              @map("public_url") @db.VarChar(1000)
  mimeType          String?              @map("mime_type") @db.VarChar(120)
  fileSize          Int?                 @map("file_size")
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalVersion ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([companyId, proposalVersionId])
  @@index([companyId, kind])
  @@map("proposal_artifacts")
}

// ---------------------------------------------------------------------------
// OpenAI — control de gasto, auditoría y presupuestos por tenant (multi-tenant)
// ---------------------------------------------------------------------------

enum OpenAIOperationType {
  INTENT_EXTRACTION
  PROPOSAL_COPY
  EMBEDDING
  TRIP_PDF_EXTRACTION
  OTHER
}

enum OpenAIUsageLogStatus {
  SUCCESS
  BLOCKED
  ERROR
  FALLBACK
}

model OpenAIUsageLog {
  id            String               @id @default(uuid()) @db.Char(36)
  companyId     String               @map("company_id") @db.Char(36)
  userId        String?              @map("user_id") @db.Char(36)
  operationType OpenAIOperationType  @map("operation_type")
  model         String               @db.VarChar(80)
  inputTokens   Int                  @default(0) @map("input_tokens")
  outputTokens  Int                  @default(0) @map("output_tokens")
  totalTokens   Int                  @default(0) @map("total_tokens")
  estimatedCost Decimal?             @map("estimated_cost") @db.Decimal(14, 6)
  requestId     String?              @map("request_id") @db.VarChar(120)
  status        OpenAIUsageLogStatus
  errorCode     String?              @map("error_code") @db.VarChar(64)
  durationMs    Int?                 @map("duration_ms")
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([operationType, createdAt])
  @@index([status, createdAt])
  @@map("openai_usage_logs")
}

model OpenAIUsageBudget {
  id                  String   @id @default(uuid()) @db.Char(36)
  companyId           String   @unique @map("company_id") @db.Char(36)
  dailyLimitEuros     Decimal? @map("daily_limit_euros") @db.Decimal(14, 6)
  monthlyLimitEuros   Decimal? @map("monthly_limit_euros") @db.Decimal(14, 6)
  maxCallsPerHour     Int?     @map("max_calls_per_hour")
  maxTokensPerRequest Int?     @map("max_tokens_per_request")
  userDailyLimitEuros Decimal? @map("user_daily_limit_euros") @db.Decimal(14, 6)
  isEnabled           Boolean  @default(true) @map("is_enabled")
  hardBlocked         Boolean  @default(false) @map("hard_blocked")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("openai_usage_budgets")
}

/// Estado global (una fila `default`). Kill switch en BD además de variables de entorno.
model OpenAISystemState {
