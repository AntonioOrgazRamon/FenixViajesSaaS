// Motor por defecto: MySQL (p. ej. Hostinger Web/Cloud).
// Los UUID se guardan como CHAR(36) para poder pasar a PostgreSQL sin rediseñar datos:
// al cambiar de motor solo ajustas `provider`, `DATABASE_URL` y (opcional) `@db.Uuid`.
//
// === Migración rápida a PostgreSQL (checklist) ===
// 1. Postgres vacío y DATABASE_URL, p. ej. postgresql://user:pass@host:5432/saas_db?schema=public
// 2. En `datasource db`: provider = "postgresql"
// 3. Opcional: en cada id/UUID, cambia @db.Char(36) -> @db.Uuid y genera migración (mismos strings UUID en datos).
// 4. Vuelca datos MySQL -> Postgres (pgloader, ETL, o export/import CSV según volumen).
// 5. npx prisma migrate deploy (o db push en entorno de prueba) y npx prisma generate
//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LOCAL_GOOGLE
}

enum UserAvatarType {
  DEFAULT
  UPLOADED
}

enum UserAvatarShape {
  CIRCLE
  ROUNDED
  SQUARE
}

enum LeadSource {
  WEB_FORM
  CHATBOT
  PLAN_CTA
  MANUAL
  IMPORT
  API
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  CONTACTED
  WAITING
  CONVERTED
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadLanguage {
  es
  en
}

enum LeadActorType {
  USER
  SYSTEM
  AGENT
}

enum LeadActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  AGENT_RUN
  ENRICHED
  QUALIFIED
  CONTACTED
  IMPORT
  EXTERNAL_EVENT
}

enum LeadAgentTriggerType {
  ON_CREATE
  MANUAL
  SCHEDULED
  ON_UPDATE
}

enum LeadAgentRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Company {
  id                String        @id @default(uuid()) @db.Char(36)
  name              String        @db.VarChar(150)
  slug              String        @unique @db.VarChar(100)
  status            CompanyStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  suspendedAt       DateTime?     @map("suspended_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdBy         String?       @map("created_by") @db.Char(36)
  integrationToken  String?       @unique @map("integration_token") @db.VarChar(64)

  users             User[]
  auditLogs         AuditLog[]
  leads             Lead[]
  leadDetails       LeadDetail[]
  leadActivities    LeadActivity[]
  leadNotes         LeadNote[]
  leadAgentRuns     LeadAgentRun[]

  travelDocuments   TravelDocument[]
  travelTrips       TravelTrip[]
  destinations      Destination[]
  travelImportJobs  TravelImportJob[]

  @@index([status])
  @@map("companies")
}

model User {
  id                  String        @id @default(uuid()) @db.Char(36)
  companyId           String?       @map("company_id") @db.Char(36)
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @map("password_hash")
  role                Role
  status              UserStatus    @default(ACTIVE)
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  phone               String?
  locale              String?
  timezone            String?
  avatarUrl           String?          @map("avatar_url") @db.VarChar(500)
  avatarType          UserAvatarType   @default(DEFAULT) @map("avatar_type")
  avatarBackgroundColor String?        @map("avatar_background_color") @db.VarChar(7)
  avatarTextColor       String?        @map("avatar_text_color") @db.VarChar(7)
  avatarInitials        String?        @map("avatar_initials") @db.VarChar(3)
  avatarShape           UserAvatarShape @default(CIRCLE) @map("avatar_shape")
  theme               Theme         @default(SYSTEM)
  googleId            String?       @unique @map("google_id") @db.VarChar(255)
  authProvider        AuthProvider  @default(LOCAL) @map("auth_provider")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company             Company?      @relation(fields: [companyId], references: [id])
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  auditLogs           AuditLog[]    @relation("ActorLogs")
  assignedLeads       Lead[]        @relation("LeadAssigned")
  createdLeads        Lead[]        @relation("LeadCreated")
  leadActivities      LeadActivity[]
  leadNotes           LeadNote[]

  @@index([companyId, role, status])
  @@index([companyId, status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  companyId        String?   @map("company_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt, expiresAt])
  @@index([companyId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  /// SHA-256 hex (o HMAC) del token en claro. Nunca guardar el token en texto plano.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(500)

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String?  @map("company_id") @db.Char(36)
  actorUserId     String?  @map("actor_user_id") @db.Char(36)
  actorRole       String?  @map("actor_role")
  action          String
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  targetCompanyId String?  @map("target_company_id") @db.Char(36)
  result          String
  reason          String?
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  company         Company? @relation(fields: [companyId], references: [id])
  actorUser       User?    @relation("ActorLogs", fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Lead {
  id                 String        @id @default(uuid()) @db.Char(36)
  companyId          String        @map("company_id") @db.Char(36)
  source             LeadSource
  sourceDetail       String?       @map("source_detail") @db.VarChar(150)
  status             LeadStatus    @default(NEW)
  priority           LeadPriority?
  firstName          String?       @map("first_name") @db.VarChar(120)
  lastName           String?       @map("last_name") @db.VarChar(120)
  fullName           String?       @map("full_name") @db.VarChar(255)
  email              String?       @db.VarChar(255)
  phone              String?       @db.VarChar(50)
  companyName        String?       @map("company_name") @db.VarChar(180)
  country            String?       @db.VarChar(80)
  language           LeadLanguage?
  timezone           String?       @db.VarChar(100)
  message            String?       @db.Text
  rawPayload         Json?         @map("raw_payload")
  normalizedPayload  Json?         @map("normalized_payload")
  leadScore          Int?          @map("lead_score")
  assignedUserId     String?       @map("assigned_user_id") @db.Char(36)
  createdByUserId    String?       @map("created_by_user_id") @db.Char(36)
  lastAgentRunAt     DateTime?     @map("last_agent_run_at")
  lastContactedAt    DateTime?     @map("last_contacted_at")
  convertedAt        DateTime?     @map("converted_at")
  lostAt             DateTime?     @map("lost_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  company            Company       @relation(fields: [companyId], references: [id])
  assignedUser       User?         @relation("LeadAssigned", fields: [assignedUserId], references: [id])
  createdByUser      User?         @relation("LeadCreated", fields: [createdByUserId], references: [id])
  details            LeadDetail?
  activities         LeadActivity[]
  notes              LeadNote[]
  agentRuns          LeadAgentRun[]

  @@index([companyId, status, createdAt])
  @@index([companyId, source, createdAt])
  @@index([companyId, assignedUserId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@map("leads")
}

model LeadDetail {
  id                 String   @id @default(uuid()) @db.Char(36)
  leadId             String   @unique @map("lead_id") @db.Char(36)
  companyId          String   @map("company_id") @db.Char(36)
  purchaseHistory    Json?    @map("purchase_history")
  currentContext     Json?    @map("current_context")
  requirements       Json?
  preferences        Json?
  technicalSnapshot  Json?    @map("technical_snapshot")
  commercialSnapshot Json?    @map("commercial_snapshot")
  extraData          Json?    @map("extra_data")
  travelContext      Json?    @map("travel_context")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company            Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, leadId])
  @@map("lead_details")
}

model LeadActivity {
  id            String           @id @default(uuid()) @db.Char(36)
  companyId     String           @map("company_id") @db.Char(36)
  leadId        String           @map("lead_id") @db.Char(36)
  actorUserId   String?          @map("actor_user_id") @db.Char(36)
  actorType     LeadActorType    @map("actor_type")
  activityType  LeadActivityType @map("activity_type")
  title         String           @db.VarChar(160)
  description   String?          @db.Text
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")

  company       Company          @relation(fields: [companyId], references: [id])
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorUser     User?            @relation(fields: [actorUserId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@index([companyId, activityType, createdAt])
  @@map("lead_activities")
}

model LeadNote {
  id            String    @id @default(uuid()) @db.Char(36)
  companyId     String    @map("company_id") @db.Char(36)
  leadId        String    @map("lead_id") @db.Char(36)
  authorUserId  String    @map("author_user_id") @db.Char(36)
  content       String    @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company       Company   @relation(fields: [companyId], references: [id])
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorUserId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@map("lead_notes")
}

model LeadAgentRun {
  id            String               @id @default(uuid()) @db.Char(36)
  companyId     String               @map("company_id") @db.Char(36)
  leadId        String               @map("lead_id") @db.Char(36)
  agentKey      String               @map("agent_key") @db.VarChar(100)
  triggerType   LeadAgentTriggerType @map("trigger_type")
  status        LeadAgentRunStatus
  inputPayload  Json?                @map("input_payload")
  outputPayload Json?                @map("output_payload")
  errorMessage  String?              @map("error_message") @db.Text
  startedAt     DateTime?            @map("started_at")
  finishedAt    DateTime?            @map("finished_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  company       Company              @relation(fields: [companyId], references: [id])
  lead          Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId, createdAt])
  @@map("lead_agent_runs")
}

// ---------------------------------------------------------------------------
// Catálogo de viajes (ingestión PDF → viajes estructurados, multiempresa)
// ---------------------------------------------------------------------------

enum TravelDocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum TravelTripStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DestinationKind {
  COUNTRY
  REGION
  CITY
  AREA
  ATTRACTION
}

enum TripServiceKind {
  INCLUDED
  NOT_INCLUDED
  OPTIONAL
}

enum TravelImportJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model TravelDocument {
  id                 String               @id @default(uuid()) @db.Char(36)
  companyId          String               @map("company_id") @db.Char(36)
  filename           String               @db.VarChar(255)
  originalName       String               @map("original_name") @db.VarChar(500)
  mimeType           String               @map("mime_type") @db.VarChar(120)
  size               Int
  storagePath        String               @map("storage_path") @db.VarChar(1000)
  status             TravelDocumentStatus @default(UPLOADED)
  totalPages         Int?                 @map("total_pages")
  extractedTextPath  String?              @map("extracted_text_path") @db.VarChar(1000)
  errorMessage       String?              @map("error_message") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips              TravelTrip[]
  importJobs         TravelImportJob[]

  @@index([companyId, status, createdAt])
  @@map("travel_documents")
}

model TravelTrip {
  id                 String            @id @default(uuid()) @db.Char(36)
  companyId          String            @map("company_id") @db.Char(36)
  documentId         String?           @map("document_id") @db.Char(36)
  title              String            @db.VarChar(500)
  provider           String?           @db.VarChar(255)
  season             String?           @db.VarChar(120)
  mainDestination    String?           @map("main_destination") @db.VarChar(300)
  description        String?           @db.Text
  durationDays       Int?              @map("duration_days")
  durationNights     Int?              @map("duration_nights")
  indicativePrice    Decimal?          @map("indicative_price") @db.Decimal(12, 2)
  currency           String?           @db.VarChar(3)
  status             TravelTripStatus  @default(PENDING_REVIEW)
  confidenceScore    Float?            @map("confidence_score")
  sourcePageStart    Int?              @map("source_page_start")
  sourcePageEnd      Int?              @map("source_page_end")
  rawExtractedText   String?           @map("raw_extracted_text") @db.LongText
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document           TravelDocument?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tripDestinations   TravelTripDestination[]
  itineraryDays      TripItineraryDay[]
  services           TripCatalogService[]
  departures         TripDeparture[]
  hotels             TripHotel[]
  highlights         TripHighlight[]
  observations       TripObservation[]

  @@index([companyId, status, createdAt])
  @@index([companyId, documentId])
  @@index([documentId])
  @@map("travel_trips")
}

model Destination {
  id                String            @id @default(uuid()) @db.Char(36)
  companyId         String            @map("company_id") @db.Char(36)
  name              String            @db.VarChar(255)
  type              DestinationKind
  normalizedName    String            @map("normalized_name") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripDestinations  TravelTripDestination[]

  @@unique([companyId, normalizedName, type])
  @@index([companyId, normalizedName])
  @@map("destinations")
}

model TravelTripDestination {
  tripId         String       @map("trip_id") @db.Char(36)
  destinationId  String       @map("destination_id") @db.Char(36)
  orderIndex     Int          @default(0) @map("order_index")

  trip           TravelTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([tripId, destinationId])
  @@index([destinationId])
  @@map("travel_trip_destinations")
}

model TripItineraryDay {
  id             String     @id @default(uuid()) @db.Char(36)
  tripId         String     @map("trip_id") @db.Char(36)
  dayNumber      Int        @map("day_number")
  title          String?    @db.VarChar(500)
  description    String?    @db.Text
  meals          String?    @db.Text
  accommodation  String?    @db.Text
  orderIndex     Int        @default(0) @map("order_index")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  trip           TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayNumber])
  @@map("trip_itinerary_days")
}

model TripCatalogService {
  id        String          @id @default(uuid()) @db.Char(36)
  tripId    String          @map("trip_id") @db.Char(36)
  type      TripServiceKind
  text      String          @db.Text
  orderIndex Int            @default(0) @map("order_index")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  trip      TravelTrip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, type])
  @@map("trip_catalog_services")
}

model TripDeparture {
  id            String     @id @default(uuid()) @db.Char(36)
  tripId        String     @map("trip_id") @db.Char(36)
  departureText String     @map("departure_text") @db.Text
  startDate     DateTime?  @map("start_date") @db.Date
  endDate       DateTime?  @map("end_date") @db.Date
  weekdays      String?    @db.VarChar(100)
  orderIndex    Int        @default(0) @map("order_index")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  trip          TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_departures")
}

model TripHotel {
  id         String     @id @default(uuid()) @db.Char(36)
  tripId     String     @map("trip_id") @db.Char(36)
  category   String?    @db.VarChar(50)
  city       String?    @db.VarChar(150)
  hotelName  String?    @map("hotel_name") @db.VarChar(255)
  orderIndex Int        @default(0) @map("order_index")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  trip       TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_hotels")
}

model TripHighlight {
  id         String     @id @default(uuid()) @db.Char(36)
  tripId     String     @map("trip_id") @db.Char(36)
  text       String     @db.Text
  orderIndex Int        @default(0) @map("order_index")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  trip       TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_highlights")
}

model TripObservation {
  id         String     @id @default(uuid()) @db.Char(36)
  tripId     String     @map("trip_id") @db.Char(36)
  text       String     @db.Text
  orderIndex Int        @default(0) @map("order_index")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  trip       TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_observations")
}

model TravelImportJob {
  id             String                @id @default(uuid()) @db.Char(36)
  companyId      String                @map("company_id") @db.Char(36)
  documentId     String?               @map("document_id") @db.Char(36)
  status         TravelImportJobStatus @default(PENDING)
  currentStep    String?               @map("current_step") @db.VarChar(200)
  progress       Int                   @default(0)
  errorMessage   String?               @map("error_message") @db.Text
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document       TravelDocument?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([companyId, documentId, createdAt])
  @@index([status, createdAt])
  @@map("travel_import_jobs")
}
