}

model ProposalVersion {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String   @map("company_id") @db.Char(36)
  proposalId      String   @map("proposal_id") @db.Char(36)
  versionNumber   Int      @map("version_number")
  /// Snapshot de intención/criterios al generar esta versión (JSON libre).
  intentSnapshot  Json?    @map("intent_snapshot")
  generatedHtml   String?  @map("generated_html") @db.LongText
  pdfStoragePath  String?  @map("pdf_storage_path") @db.VarChar(1000)
  pdfPublicUrl    String?  @map("pdf_public_url") @db.VarChar(1000)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposal      Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdByUser User?              @relation("ProposalVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  trips         ProposalTrip[]
  artifacts     ProposalArtifact[]

  @@unique([proposalId, versionNumber])
  @@index([companyId, proposalId])
  @@index([proposalId, createdAt])
  @@map("proposal_versions")
}

model ProposalTrip {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @map("company_id") @db.Char(36)
  proposalVersionId String   @map("proposal_version_id") @db.Char(36)
  travelTripId      String   @map("travel_trip_id") @db.Char(36)
