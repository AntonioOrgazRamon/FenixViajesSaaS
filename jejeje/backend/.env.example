# Copia a .env y ajusta valores. Ver SETUP_DB.md (MySQL / Hostinger / Docker).

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# MySQL (URL de conexión Prisma)
# Ejemplo local XAMPP:
# DATABASE_URL="mysql://root:@localhost:3306/practicas_mvp"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nombre_bd"

# Cambiar en producción (mínimo 32 caracteres aleatorios)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
